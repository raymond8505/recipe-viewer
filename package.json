{
  "name": "recipe-viewer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy:quick": "yarn build && deploy",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir public/storybook",
    "build:prod": "yarn build-storybook && yarn build",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --max-warnings 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "next": "^16.1.7",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.3.3",
    "@storybook/nextjs-vite": "^10.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.3",
    "postcss": "^8",
    "storybook": "^10.3.3",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vite": "^7.0.0",
    "vite-plugin-storybook-nextjs": "^3.0.3",
    "vitest": "^3.1.1"
  }
}
