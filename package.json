{
  "name": "recipe-viewer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy:quick": "yarn build && deploy",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir public/storybook",
    "build:prod": "yarn build-storybook && yarn build",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --max-warnings 0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
