# Per-checkout dev ports & hostname — copy to .env.yarn (gitignored) and adjust.
#
# Yarn 4 injects .env.yarn into every `yarn <script>` run (injectEnvironmentFiles),
# which is what lets each checkout of this repo on the same machine claim its own
# ports. Without a .env.yarn the defaults below apply, matching historical behavior.
#
# If you run Claude Code in this checkout, mirror SB_HOST/SB_PORT (and PORT) into
# .claude/settings.local.json's "env" block — .mcp.json's storybook URL is expanded
# from the Claude session env, not from this file. Also point MCP_PUBLIC_URL in
# .env.local at this checkout's own host:port.
#
# Prefer a distinct hostname (e.g. 127.0.0.1 vs localhost) per checkout: cookies
# ignore ports, so two localhost dev servers share the auth_session cookie jar.

# next dev port
PORT=3000

# storybook dev port
SB_PORT=6006

# hostname tooling uses to reach this checkout's storybook (see .mcp.json)
SB_HOST=localhost
